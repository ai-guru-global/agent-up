# EditorConfig：https://editorconfig.org
# 让不同编辑器/IDE 在本仓库保持一致的基础格式
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 行尾双空格是硬换行语法，不裁剪
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
