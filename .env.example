# Database（批0 起测试/迁移必填；docker compose up -d postgres 启动本地库）
# 注意：Prisma CLI 按 CWD 读 .env，需把同一 DATABASE_URL 配到 packages/db/.env
DATABASE_URL="postgresql://agentup:agentup@localhost:5432/agentup?schema=public"

# Auth（会话令牌签名；消费方 apps/web/lib/auth-token.ts）
# AUTH_SECRET 未配置时：登录仍返回成功，但签不出令牌，所有写操作的审计署名落到 anonymous。
# 生产环境必须配置。注意 Next.js 只读 apps/web/.env，实际使用时请配在那里。
AUTH_SECRET="change-me-in-production"
# 会话有效期（小时），默认 24
AUTH_SESSION_TTL_HOURS="24"
# 是否采纳明文 x-actor-* 请求头作为身份（chrome-extension 依赖此路径）。
# 缺省：非 production 采纳、production 拒绝。1=强制采纳，0=强制拒绝。
# 只有当调用方本身已通过可信网关鉴权时，才应在 production 置 1。
AUTH_TRUST_ACTOR_HEADERS=""

# MiMo (Xiaomi) LLM — Token Plan（tp- 前缀 key + 套餐专属 Base URL）
# 注意：Next.js 只读 apps/web/ 目录下的 .env，实际使用时请配在 apps/web/.env
# OpenAI 兼容协议；中国集群：https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=""
MIMO_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"
