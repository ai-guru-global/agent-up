# Database
DATABASE_URL="postgresql://agentup:agentup@localhost:5432/agentup?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# S3 (Wiki Vault snapshots)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="agent-up-wiki"

# Git (Wiki Vault repos)
WIKI_GIT_BASE_PATH="/tmp/agent-up-wiki-repos"

# MiMo (Xiaomi) LLM — Token Plan（tp- 前缀 key + 套餐专属 Base URL）
# 注意：Next.js 只读 apps/web/ 目录下的 .env，实际使用时请配在 apps/web/.env
# OpenAI 兼容协议；中国集群：https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=""
MIMO_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"
