{
  "manifest_version": 3,
  "name": "agent-up 反馈收集器",
  "short_name": "agent-up 反馈",
  "description": "在 Agent 试聊/客服场景一键沉淀反馈，自动携带会话上下文，直落 agent-up 反馈池（演示 PoC）",
  "version": "0.1.0",
  "action": {
    "default_title": "agent-up 反馈收集",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
