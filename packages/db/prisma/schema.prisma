// SQLite 版 schema（2026-10-05 自 PostgreSQL 迁移）。
//
// Prisma SQLite 连接器不支持 enum / Json / 标量数组（String[]），故：
// - 原 18 个 enum 定义移至 packages/db/src/enums.ts（const 对象 + 同名 union type），
//   列一律改为 String，值域校验由 lib/schemas.ts 的 Zod 承担；
// - 原 Json 字段 → String，存 JSON.stringify 产物，读写经 @agent-up/db 的
//   packJson / unpackJson 收口（解析失败回落 fallback，绝不抛）；
// - 原标量数组 → String（JSON 文本）。
// PostgreSQL 版本的历史见 git（migrations 5 个目录在本迁移中删除，可 revert 找回）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 组织与用户
// ============================================================

model ProductGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents  Agent[]
  members ProductGroupMember[]
}

model ProductGroupMember {
  id             String       @id @default(cuid())
  productGroupId String
  productGroup   ProductGroup @relation(fields: [productGroupId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  // 原 GroupRole enum
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())

  @@unique([productGroupId, userId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  productGroups ProductGroupMember[]
}

// ============================================================
// Agent 核心
// ============================================================

model Agent {
  id             String       @id @default(cuid())
  name           String
  description    String?
  productGroupId String
  productGroup   ProductGroup @relation(fields: [productGroupId], references: [id])
  // 原 AgentStatus enum
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String

  // 四分区配置
  promptConfig    PromptConfig?
  knowledgeConfig KnowledgeConfig?
  toolsConfig     ToolsConfig?
  routingConfig   RoutingConfig?

  // Draft 环境
  draftConfig AgentDraftConfig?

  // 关联实体
  feedbacks     Feedback[]
  releases      Release[]
  versions      AgentVersion[]
  skillBindings AgentSkillBinding[]
  wikiVault     WikiVault?
  configChanges ConfigChange[]
  traces        Trace[]
  evalCases     EvalCase[]

  @@index([productGroupId])
  @@index([status])
}

// ============================================================
// Agent 四分区配置
// ============================================================

model PromptConfig {
  id             String   @id @default(cuid())
  agentId        String   @unique
  agent          Agent    @relation(fields: [agentId], references: [id])
  systemPrompt   String
  roleDefinition String?
  // 原 String[]，JSON 文本
  constraints    String   @default("[]")
  outputFormat   String?
  version        Int      @default(1)
  lastModifiedBy String?
  lastModifiedAt DateTime @default(now())
}

model KnowledgeConfig {
  id                  String     @id @default(cuid())
  agentId             String     @unique
  agent               Agent      @relation(fields: [agentId], references: [id])
  wikiVaultId         String?    @unique
  wikiVault           WikiVault? @relation(fields: [wikiVaultId], references: [id])
  // 原 SearchStrategy enum
  searchStrategy      String     @default("WIKI_FIRST")
  fallbackToMcp       Boolean    @default(true)
  maxWikiResults      Int        @default(5)
  confidenceThreshold Float      @default(0.6)
  lastSyncAt          DateTime?
  // 原 SyncStatus enum
  syncStatus          String     @default("SYNCED")
  version             Int        @default(1)
  lastModifiedBy      String?
  lastModifiedAt      DateTime   @default(now())
}

model ToolsConfig {
  id                 String   @id @default(cuid())
  agentId            String   @unique
  agent              Agent    @relation(fields: [agentId], references: [id])
  // 原 Json（McpToolConfig[]）
  mcpTools           String
  // 原 Json（WikiQueryToolConfig[]）
  wikiQueryTools     String
  maxConcurrentCalls Int      @default(3)
  timeoutMs          Int      @default(30000)
  retryCount         Int      @default(2)
  version            Int      @default(1)
  lastModifiedBy     String?
  lastModifiedAt     DateTime @default(now())
}

model RoutingConfig {
  id                   String   @id @default(cuid())
  agentId              String   @unique
  agent                Agent    @relation(fields: [agentId], references: [id])
  // 原 Json（RoutingRule[]）
  rules                String
  // 原 Json?
  escalationPolicy     String?
  humanThreshold       Float    @default(0.3)
  maxConversationTurns Int      @default(10)
  idleTimeoutMinutes   Int      @default(5)
  version              Int      @default(1)
  lastModifiedBy       String?
  lastModifiedAt       DateTime @default(now())
}

model AgentDraftConfig {
  id              String    @id @default(cuid())
  agentId         String    @unique
  agent           Agent     @relation(fields: [agentId], references: [id])
  // 以下四列原 Json?
  promptConfig    String?
  knowledgeConfig String?
  toolsConfig     String?
  routingConfig   String?
  isDirty         Boolean   @default(false)
  lastSavedBy     String?
  lastSavedAt     DateTime?
}

// ============================================================
// 配置变更记录
// ============================================================

model ConfigChange {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  // 回滚留痕会写入 "PROMPT_ROLLBACK" 等带后缀值，枚举装不下；故用文本列
  partition  String
  // 以下三列原 Json?/Json
  before     String?
  after      String
  diff       String
  changedBy  String
  changedAt  DateTime @default(now())
  changeNote String?
  releaseId  String?

  @@index([agentId, partition])
  @@index([changedAt])
}

// ============================================================
// Feedback（反馈）
// ============================================================

model Feedback {
  id               String    @id @default(cuid())
  agentId          String
  agent            Agent     @relation(fields: [agentId], references: [id])
  // 运行时把渠道名（generic/ticket-webhook）直接存 source 并原样回显，渠道集合开放
  // （新渠道 = 加适配器不改存储），枚举建模不成立，改文本列
  source           String    @default("MANUAL")
  title            String
  content          String
  // 原 Json?
  sessionData      String?
  // 原 FeedbackRating enum
  rating           String
  // 原 FeedbackTag[]，JSON 文本
  tags             String    @default("[]")
  // 原 FeedbackSeverity enum
  severity         String    @default("MINOR")
  // 原 FeedbackStatus enum
  status           String    @default("NEW")
  assignedTo       String?
  assignedAt       DateTime?
  resolvedAt       DateTime?
  resolvedBy       String?
  resolution       String?
  releaseId        String?
  ingestJobId      String?
  // 原 ConfigPartition? enum
  targetPartition  String?
  // 多渠道工单接入的外部单号（幂等键）；响应层重组为 externalRef: {id, url}
  externalRefId    String?
  externalRefUrl   String?
  submittedBy      String
  submittedAt      DateTime  @default(now())
  verifiedAt       DateTime?
  verifiedBy       String?
  verificationNote String?

  @@index([agentId, status])
  @@index([submittedAt])
  @@index([severity, status])
}

// ============================================================
// Release（发布审批）
// ============================================================

model Release {
  id                String    @id @default(cuid())
  agentId           String
  agent             Agent     @relation(fields: [agentId], references: [id])
  changeNote        String
  // 原 ConfigPartition[]，JSON 文本
  changedPartitions String    @default("[]")
  // 原 ReleaseStatus enum
  status            String    @default("PENDING")
  submittedBy       String
  submittedAt       DateTime  @default(now())
  approvedBy        String?
  approvedAt        DateTime?
  reviewComment     String?

  // 关联配置快照（原 Json?）
  configSnapshot String?

  // AI 评测结果快照（2026-09 断言门禁，运行时为自由形状 AiReviewResult；原 Json?）
  aiReview String?

  // 整版本回滚单（JSON 时代的动态键上列；普通发布恒为 false/null）
  isRollback          Boolean @default(false)
  rollbackFromVersion String?
  rollbackToVersionId String?

  // 关联
  version AgentVersion?

  @@index([agentId, status])
  @@index([submittedAt])
}

// ============================================================
// Version（版本快照）
// ============================================================

model AgentVersion {
  id                  String   @id @default(cuid())
  agentId             String
  agent               Agent    @relation(fields: [agentId], references: [id])
  version             String
  major               Int
  minor               Int
  patch               Int
  // 以下四列原 Json
  promptSnapshot      String
  knowledgeSnapshot   String
  toolsSnapshot       String
  routingSnapshot     String
  releaseId           String   @unique
  release             Release  @relation(fields: [releaseId], references: [id])
  wikiCommitSha       String?
  publishedAt         DateTime @default(now())
  publishedBy         String
  changeNote          String
  // 原 Json?
  effectivenessReport String?

  @@unique([agentId, version])
  @@index([agentId, publishedAt])
}

// ============================================================
// Skill（技能插件）
// ============================================================

model Skill {
  id              String    @id @default(cuid())
  name            String    @unique
  displayName     String
  description     String
  // 原 SkillCategory enum
  category        String    @default("GENERAL")
  // 原 String[]，JSON 文本
  triggerPatterns String    @default("[]")
  // 原 Json
  inputSchema     String
  outputSchema    String
  // 原 SkillRuntime enum
  runtime         String    @default("HTTP")
  endpoint        String?
  codeRef         String?
  version         String    @default("1.0.0")
  // 原 String[]，JSON 文本
  dependencies    String    @default("[]")
  permissions     String    @default("[]")
  // 原 SkillStatus enum
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  downloadCount   Int       @default(0)
  authorId        String
  authorName      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bindings AgentSkillBinding[]
  versions SkillVersion[]

  @@index([category, status])
}

model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id])
  version     String
  changelog   String?
  // 原 Json
  snapshot    String
  publishedAt DateTime @default(now())

  @@unique([skillId, version])
  @@index([skillId])
}

model AgentSkillBinding {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id])
  // 原 Json?
  config        String?
  enabled       Boolean  @default(true)
  priority      Int      @default(0)
  // 运行时 binding 无该字段，空数组默认；原 String[]
  allowedScopes String   @default("[]")
  boundAt       DateTime @default(now())
  boundBy       String

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
}

// ============================================================
// Wiki（知识库）
// ============================================================

model WikiVault {
  id            String   @id @default(cuid())
  name          String
  description   String?
  agentId       String?  @unique
  agent         Agent?   @relation(fields: [agentId], references: [id])
  gitRepoUrl    String?
  gitBranch     String   @default("main")
  lastCommitSha String?
  pageCount     Int      @default(0)
  avgConfidence Float    @default(0.0)
  orphanCount   Int      @default(0)
  isShared      Boolean  @default(false)
  sharedBy      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages           WikiPage[]
  ingestJobs      WikiIngestJob[]
  knowledgeConfig KnowledgeConfig?

  @@index([isShared])
}

model WikiPage {
  id             String    @id @default(cuid())
  vaultId        String
  // 运行时 deleteVault 语义 = 整库连页面一起消失（fs 递归删目录），级联才能成立
  vault          WikiVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  content        String
  summary        String?
  // 运行时 zod schema 的枚举值即公开契约（UI 按此收发），三枚举对齐运行时
  // 原 Provenance / PageLifecycle / PageTier enum
  provenance     String    @default("EXTRACTED")
  lifecycle      String    @default("DRAFT")
  tier           String    @default("SPECIALIZED")
  baseConfidence Float     @default(0.5)
  // 原 Json
  sourceRefs     String    @default("[]")
  // 以下三列原 String[]，JSON 文本
  wikilinks      String    @default("[]")
  categories     String    @default("[]")
  tags           String    @default("[]")
  filePath       String
  lastCommitSha  String?
  inboundLinks   Int       @default(0)
  outboundLinks  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviewedAt     DateTime?
  reviewedBy     String?

  @@unique([vaultId, slug])
  @@index([vaultId, lifecycle])
  @@index([vaultId, tier])
}

model WikiIngestJob {
  id               String    @id @default(cuid())
  vaultId          String
  vault            WikiVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  // 原 WikiJobType enum
  jobType          String
  sourceType       String
  sourceId         String?
  sourceContent    String?
  sourceUrl        String?
  // 原 String[]，JSON 文本
  generatedPageIds String    @default("[]")
  // 原 JobStatus enum
  status           String    @default("PENDING")
  // 原 Json?
  result           String?
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  triggeredBy      String
  createdAt        DateTime  @default(now())

  @@index([vaultId, status])
  @@index([jobType, status])
}

// ============================================================
// 权限与审计
// ============================================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String?
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  members     UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id])
  productGroupId String?
  assignedAt     DateTime @default(now())
  assignedBy     String

  @@unique([userId, roleId, productGroupId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String
  // 原 Json?
  details    String?
  // 运行时审计流没有 userId 概念；落 actor.id（"system" 或请求头值），
  // 仅作查询别名（GET /api/settings/audit-logs?userId= 兼容），不建外键
  userId     String?
  userName   String
  userRole   String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ============================================================
// 试聊 Trace 与评测用例（2026-09 运行时新增，schema 补齐漂移）
// ============================================================

model Trace {
  id           String    @id @default(cuid())
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id])
  systemPrompt String
  // 原 Json
  history      String
  message      String
  reply        String
  model        String
  // 原 Json
  usage        String
  latencyMs    Int
  createdAt    DateTime  @default(now())
  rating       String?
  ratedAt      DateTime?
  note         String?

  @@index([agentId, createdAt])
}

model EvalCase {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  sourceTraceId  String
  title          String
  expectation    String
  // 原 Json?
  assertions     String?
  systemPrompt   String
  // 原 Json
  history        String
  message        String
  referenceReply String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  createdBy      String

  @@index([agentId, createdAt])
}
